#include <iostream>

using namespace std;

int gcd(int a, int b) {
    if (b == 0) return a;
    return gcd(b, a % b);
}
int commonFactors(int a, int b) {
    int g = gcd(a, b);
    int count = 0;
    
    for (int i = 1; i <= g; i++) {
        if (g % i == 0) {
            count++;
        }
    }
    
    return count;
}

int main() {
    int a, b;
    cin >> a >> b;
    cout << commonFactors(a, b) << endl;
    return 0;
}
